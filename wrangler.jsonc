{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "room-tba",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "workers_dev": true,
  "vars": {
    // The adapter's loadWranglerEnv copies .env/.env.local into process.env at
    // build time; an explicit var keeps production builds from baking the
    // staging banner.
    "PUBLIC_APP_ENV": "production"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Browser navigations (sec-fetch-mode: navigate) to paths with no static
    // asset otherwise get the SPA shell before the Worker runs — which broke
    // every link-based GET endpoint: Google OAuth start/callback/link,
    // email confirmation, password reset. The Worker serves assets itself
    // through the ASSETS binding, so it must see every request.
    "run_worker_first": true
  },
  // Postgres goes straight to DATABASE_URL (a Worker secret, set with
  // `wrangler secret put DATABASE_URL`). Optional: for Hyperdrive connection
  // pooling at the edge, create a config (`wrangler hyperdrive create`) and
  // add a `"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<config id>" }]`
  // block here; src/lib/db.ts picks up env.HYPERDRIVE automatically.
  // PASSWORD_PEPPER / PASSWORD_KDF_ITERATIONS are secrets too —
  // `wrangler secret put <NAME>`; see .env.example.
  "routes": [{ "pattern": "room-tba.uplb.tools", "custom_domain": true }]
}
