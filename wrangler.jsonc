{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "room-tba",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "workers_dev": true,
  "vars": {
    // The adapter's loadWranglerEnv copies .env/.env.local into process.env at
    // build time; an explicit var keeps production builds from baking the
    // staging banner.
    "PUBLIC_APP_ENV": "production"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Optional: point Postgres through a Cloudflare Hyperdrive config for
  // connection pooling at the edge. Create one in the dashboard (or
  // `wrangler hyperdrive create`), paste its id below, and the Worker uses
  // its connection string instead of DATABASE_URL. Remove the block to use
  // DATABASE_URL directly.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ],
  "routes": [{ "pattern": "room-tba.uplb.tools", "custom_domain": true }]
}
