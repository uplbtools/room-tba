---
export const prerender = true;

import WikiLayout from "@layouts/WikiLayout.astro";
import { WIKI_PAGES } from "@lib/wiki-pages";
import { wikiProvenance } from "@lib/wiki-provenance";

const dateFormat = new Intl.DateTimeFormat("en-PH", { dateStyle: "medium" });

const articles = [
  ...WIKI_PAGES,
  {
    path: "/faq",
    title: "Frequently asked questions",
    kicker: "Student FAQ",
    blurb:
      "Where the 3D building models come from, whether Room TBA is official UPLB, how class and room data is updated, and how to report wrong data. Short, plain-language answers for students.",
    sourcePath: "src/pages/faq.astro",
  },
].map((article) => {
  const { authors, lastEdited } = wikiProvenance(article.sourcePath);
  return {
    ...article,
    authors: authors.map((a) => a.name).join(", "),
    lastEdited: lastEdited ? dateFormat.format(new Date(lastEdited)) : null,
  };
});

const title = "Wiki | Room TBA";
const description =
  "Plain-language guides to UPLB class schedules, section names, rooms, jeepneys, and campus systems, backed by Room TBA data.";
---

<WikiLayout {title} {description} canonicalPath="/wiki">
  <article class="wiki-article">
    <header class="article-hero">
      <p class="wiki-eyebrow">Room TBA Wiki</p>
      <h1 class="wiki-title">The campus details nobody explains</h1>
      <p class="wiki-lede">
        Short guides built from Room TBA’s schedule and campus data. Each
        article shows its evidence, who wrote it, and the cases where the
        pattern breaks. Spotted a mistake? Every article has a “Report a
        correction” link.
      </p>
    </header>

    <section aria-labelledby="articles-heading">
      <h2 id="articles-heading">Articles</h2>
      <form class="wiki-search" role="search" id="wiki-search" hidden>
        <label for="wiki-search-input">Filter articles</label>
        <input
          id="wiki-search-input"
          type="search"
          placeholder="Try: curfew, jeep, TBA"
          autocomplete="off"
          enterkeyhint="search"
        />
        <p class="wiki-search__status" role="status" aria-live="polite"></p>
      </form>
      <dl class="wiki-index" id="wiki-index">
        {
          articles.map((article) => (
            <div class="wiki-index__item" data-search={`${article.title} ${article.kicker} ${article.blurb}`.toLowerCase()}>
              <dt><a href={article.path}>{article.title}</a></dt>
              <dd>
                <p class="wiki-index__blurb">{article.blurb}</p>
                <p class="wiki-index__meta">
                  {article.kicker}
                  {article.lastEdited && `. Updated ${article.lastEdited}`}
                  {article.authors && `. By ${article.authors}`}
                </p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="resources-heading">
      <h2 id="resources-heading">More UPLB resources</h2>
      <ul>
        <li>
          <a href="/">Open the Room TBA map</a>
        </li>
        <li>
          <a href="https://www.uplb.tools/transparency" target="_blank" rel="noopener noreferrer">
            Transparency report</a> (where donation and sponsor money goes)
            <span aria-hidden="true">↗</span>
        </li>
        <li>
          <a href="https://guide.stimmie.dev" target="_blank" rel="noopener noreferrer">
            UPLB resources and guides</a> <span aria-hidden="true">↗</span>
        </li>
        <li>
          <a href="https://uplb.tools" target="_blank" rel="noopener noreferrer">
            More UPLB Tools</a> <span aria-hidden="true">↗</span>
        </li>
      </ul>
    </section>
  </article>
</WikiLayout>

<script is:inline>
  // Progressive enhancement: the filter only appears when script runs, and the
  // full list is always in the HTML.
  (() => {
    const form = document.getElementById("wiki-search");
    const input = document.getElementById("wiki-search-input");
    const items = [...document.querySelectorAll(".wiki-index__item")];
    if (!form || !input) return;
    const status = form.querySelector(".wiki-search__status");
    form.hidden = false;
    form.addEventListener("submit", (event) => event.preventDefault());
    input.addEventListener("input", () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const item of items) {
        const text = item.getAttribute("data-search") || "";
        const match = terms.every((term) => text.includes(term));
        item.hidden = !match;
        if (match) shown += 1;
      }
      if (status) {
        status.textContent = terms.length
          ? `${shown} of ${items.length} articles`
          : "";
      }
    });
  })();
</script>

<style>
  .wiki-index {
    max-width: var(--wiki-measure);
    margin: 0;
  }

  .wiki-index__item {
    margin-top: 1.25rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--wiki-rule);
  }

  .wiki-index__item[hidden] {
    display: none;
  }

  .wiki-index dt {
    font-family: var(--wiki-font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .wiki-index dd {
    margin: 0.35rem 0 0;
  }

  .wiki-index__blurb {
    margin: 0;
  }

  .wiki-index__meta {
    margin: 0.35rem 0 0;
    color: var(--wiki-ink-2);
    font-size: var(--wiki-text-md);
  }

  .wiki-search {
    max-width: var(--wiki-measure);
    margin: var(--wiki-space-sm) 0 0;
  }

  .wiki-search[hidden] {
    display: none;
  }

  .wiki-search label {
    display: block;
    margin-bottom: var(--wiki-space-2xs);
    color: var(--wiki-ink-2);
    font-size: var(--wiki-text-md);
  }

  .wiki-search input {
    box-sizing: border-box;
    width: 100%;
    min-height: 2.75rem;
    padding: 0 var(--wiki-space-sm);
    border: 1px solid var(--wiki-rule-strong);
    border-radius: 0.5rem;
    background: var(--wiki-paper);
    color: var(--wiki-ink);
    font: inherit;
    font-size: 1rem;
  }

  .wiki-search__status {
    min-height: 1.25rem;
    margin: var(--wiki-space-2xs) 0 0;
    color: var(--wiki-ink-2);
    font-size: var(--wiki-text-md);
  }

  @media print {
    .wiki-search {
      display: none;
    }
  }
</style>
