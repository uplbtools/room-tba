  }

  .article-meta {
    margin: 1rem 0 0;
    color: hsl(0, 0%, 48%);
    font-size: 0.8rem;
  }

  .toc {
    margin: 2rem 0 0;
    padding: 1rem 1.15rem;
    border: 1px solid hsl(0, 0%, 88%);
    border-radius: 0.85rem;
    background: hsl(0, 0%, 99%);
  }

  .toc__title {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 750;
    color: hsl(0, 0%, 35%);
  }

  .toc ol {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    color: hsl(0, 0%, 30%);
