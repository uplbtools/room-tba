    line-height: 1.65;
  }

  .toc a {
    color: hsl(5, 53%, 32%);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .wiki-article section {
    margin-top: 2.5rem;
  }

  .wiki-article h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    letter-spacing: -0.02em;
  }

  .wiki-article h3 {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .wiki-article p {
    max-width: 46rem;
    margin: 0.75rem 0 0;
