---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import { verifyUnsubscribeToken } from "@lib/email/unsubscribe";
import { EMAIL_TOPIC_LABELS } from "@lib/email/unsubscribe-core";
import { unsubscribeFromTopic } from "@lib/services/notification-preferences-service";

// Opening the link changes nothing (mail scanners prefetch links); the
// button posts back here. Mail clients use the one-click API endpoint.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

let token = Astro.url.searchParams.get("token") ?? "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData().catch(() => null);
  const posted = form?.get("token");
  if (typeof posted === "string") token = posted;
}
const target = token ? verifyUnsubscribeToken(token) : null;

let state: "invalid" | "confirm" | "done" | "error" = target
  ? "confirm"
  : "invalid";
if (target && Astro.request.method === "POST") {
  try {
    await unsubscribeFromTopic(target.userId, target.topic);
    state = "done";
  } catch (error) {
    console.error("Unsubscribe failed:", error);
    state = "error";
  }
}
const topicLabel = target ? EMAIL_TOPIC_LABELS[target.topic] : "";
---

<Layout
  title="Unsubscribe | Room TBA"
  description="Stop Room TBA notification emails."
  canonicalPath="/unsubscribe"
  showAppLoadingShell={false}
  robots="noindex,nofollow"
>
  <main class="unsubscribe-page">
    <a href="/" class="back-link">
      <span aria-hidden="true">←</span> Back to Room TBA
    </a>
    <h1>Email notifications</h1>
    {state === "invalid" && (
      <p class="unsubscribe-message" role="alert">
        This unsubscribe link is invalid or has expired. You can turn emails
        off in Account settings, under Email notifications.
      </p>
    )}
    {state === "confirm" && (
      <form method="post" class="unsubscribe-form">
        <input type="hidden" name="token" value={token} />
        <p class="unsubscribe-message">Stop getting {topicLabel}?</p>
        <button type="submit" class="unsubscribe-button">Unsubscribe</button>
      </form>
    )}
    {state === "done" && (
      <p class="unsubscribe-message" role="status">
        Done. You will no longer get {topicLabel}. Turn it back on any time in
        Account settings, under Email notifications.
      </p>
    )}
    {state === "error" && (
      <p class="unsubscribe-message" role="alert">
        Something went wrong. Try again in a moment.
      </p>
    )}
  </main>
</Layout>

<style>
  .unsubscribe-page {
    max-width: 32rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    color: var(--theme-text, inherit);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
    color: var(--theme-accent-text, hsl(5, 53%, 32%));
    font-weight: 600;
    text-decoration: none;
    font-size: 0.875rem;
  }
  h1 {
    font-size: 1.5rem;
    margin: 0 0 1.25rem;
  }
  .unsubscribe-message {
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .unsubscribe-button {
    min-height: 2.5rem;
    padding: 0 1.25rem;
    border: none;
    border-radius: 999px;
    background: var(--theme-accent-fill, #7b1113);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
  }
</style>
