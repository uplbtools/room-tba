---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import AdminHome from "@ui/admin/AdminHome.svelte";
import { getActiveSessionUser } from "@lib/services/staff-security-service";

// Per-user page: never cached at the edge (it used to be an ISR-cached
// redirect that every visitor got, signed in or not).
Astro.response.headers.set("Cache-Control", "private, no-store");

// Middleware resolved who is signed in (cookie or Google); re-read the role
// so a demotion shows up immediately.
const sessionUser = Astro.locals.editorUser;
let viewer: {
  username: string;
  displayName: string;
  role: "admin" | "editor" | "contributor";
} | null = null;
if (sessionUser) {
  try {
    const current = await getActiveSessionUser(sessionUser.id);
    viewer = current
      ? {
          username: current.username,
          displayName: current.displayName,
          role: current.role,
        }
      : null;
  } catch (error) {
    console.error("Admin landing role lookup failed:", error);
  }
}
const isStaff = viewer?.role === "admin" || viewer?.role === "editor";
const heading = isStaff ? "Editor dashboard" : "Editing Room TBA";
---

<Layout
  title={`${heading} | Room TBA`}
  description="Room TBA editor dashboard and editor access."
  canonicalPath="/admin"
  showAppLoadingShell={false}
  robots="noindex,nofollow"
>
  <main class="admin-page">
    <a href="/" class="back-link">
      <span aria-hidden="true">←</span> Back to the map
    </a>
    <h1>{heading}</h1>
    <AdminHome client:load viewer={viewer} />
  </main>
</Layout>

<style>
  .admin-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    color: var(--theme-text, inherit);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
    color: var(--theme-accent-text, hsl(5, 53%, 32%));
    font-weight: 600;
    text-decoration: none;
    font-size: 0.875rem;
  }
  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  h1 {
    font-size: 1.5rem;
    margin: 0 0 1.25rem;
  }
</style>
