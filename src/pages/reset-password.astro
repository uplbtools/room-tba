---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import ResetPasswordForm from "@ui/ResetPasswordForm.svelte";
import { verifySignedToken } from "@lib/admin/signed-token";

// Per-user token page: never let the edge or the browser keep a copy, and
// keep the token out of any Referer sent by links on this page.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

// Read the token here rather than from window.location in the component, so
// the server render already has it (the client-only read crashed SSR).
const token = Astro.url.searchParams.get("token");

/** Signature and expiry only; single use is enforced on submit. */
function tokenLooksValid(value: string): boolean {
  try {
    const payload = verifySignedToken<{ purpose?: string }>(value);
    return payload?.purpose === "password-reset";
  } catch {
    return false;
  }
}

const tokenState = !token
  ? "missing"
  : tokenLooksValid(token)
    ? "ok"
    : "invalid";
---

<Layout
  title="Reset password | Room TBA"
  description="Set a new password for your Room TBA editor account."
  canonicalPath="/reset-password"
  showAppLoadingShell={false}
  robots="noindex,nofollow"
>
  <main class="reset-password-page">
    <a href="/" class="back-link">
      <span aria-hidden="true">←</span> Back to Room TBA
    </a>
    <h1>Reset your password</h1>
    <ResetPasswordForm
      client:load
      token={tokenState === "ok" ? token : null}
      tokenState={tokenState}
    />
  </main>
</Layout>

<style>
  .reset-password-page {
    max-width: 32rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    color: var(--theme-text, inherit);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
    color: var(--theme-accent-text, hsl(5, 53%, 32%));
    font-weight: 600;
    text-decoration: none;
    font-size: 0.875rem;
  }
  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  h1 {
    font-size: 1.5rem;
    margin: 0 0 1.25rem;
  }
</style>
