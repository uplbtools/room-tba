---
export const prerender = false;

import AppRoot from "@ui/AppRoot.svelte";
import Layout from "@layouts/Layout.astro";
import { getTransitRouteForPage } from "@lib/services/transit-service";
import { routeFareInfo, transitRouteNoun } from "@lib/transit-route-kind";
import { breadcrumbSchema, jsonLd, ogCardPath, webpageSchema } from "@lib/site";
import { campusTransit } from "../../campus.config";

if (!campusTransit.enabled) {
  return new Response(null, { status: 404 });
}

const routeId = Astro.params.route;
const route = await getTransitRouteForPage(routeId);
const fare = route ? routeFareInfo(route) : null;
const fareText =
  fare?.kind === "ticketed"
    ? `Buy tickets on the ${fare.ticketing.operator} website (${fare.ticketing.url}), which lists the current fare.`
    : fare?.kind === "fixed" || fare?.kind === "end-to-end"
      ? `Fare ₱${fare.fare.regular} (₱${fare.fare.discounted} student, senior or PWD). ${fare.note}`
      : (fare?.note ?? "");
const routeName = route?.name ?? "UPLB transit route";
const routeNoun = route ? transitRouteNoun(route) : "transit route";
const canonicalPath = `/transit/${encodeURIComponent(routeId ?? "")}/`;
const title = `${routeName} | UPLB Transit | Room TBA`;
const description =
  route?.description ??
  `View this UPLB ${routeNoun}, its stops, and map context in Room TBA.`;
const structuredData = jsonLd(
  webpageSchema({ title, description, path: canonicalPath }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Jeepney routes", path: "/transit/" },
    { name: routeName, path: canonicalPath },
  ]),
);
---

<Layout
  {title}
  ogTitle={routeName}
  description={description}
  {canonicalPath}
  imagePath={ogCardPath({
    title: routeName,
    subtitle: route
      ? `${route.stops.length} stops · PHP ${route.fare.regular} regular · PHP ${route.fare.discounted} discounted`
      : "Transit at UPLB",
    kicker: "Transit at UPLB",
  })}
  {structuredData}
>
  <main class="transit-page">
    <article class="sr-only">
      <h1>{routeName}</h1>
      <p>{description}</p>
      {route && (
        <p>
          {route.stops.length} stops.{" "}
          {fareText}
        </p>
      )}
    </article>
    <AppRoot client:only="svelte" suppressLandingModal={true} />
  </main>
</Layout>

<style>
  .transit-page { height: 100dvh; overflow: hidden; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
