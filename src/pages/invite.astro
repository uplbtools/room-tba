---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import InviteAcceptForm from "@ui/InviteAcceptForm.svelte";
import { findUsableInvite } from "@lib/services/staff-invite-service";

// Per-person token page: never cached, token kept out of Referer.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const token = Astro.url.searchParams.get("token");
let invite: { email: string; role: string; displayName: string | null } | null =
  null;
if (token) {
  try {
    const found = await findUsableInvite(token);
    invite = found
      ? { email: found.email, role: found.role, displayName: found.displayName }
      : null;
  } catch (error) {
    console.error("Invite lookup failed:", error);
  }
}
---

<Layout
  title="Accept invite | Room TBA"
  description="Create your Room TBA editor account from an invite."
  canonicalPath="/invite"
  showAppLoadingShell={false}
  robots="noindex,nofollow"
>
  <main class="invite-page">
    <a href="/" class="back-link">
      <span aria-hidden="true">←</span> Back to Room TBA
    </a>
    <h1>Join Room TBA</h1>
    <InviteAcceptForm client:load token={invite ? token : null} invite={invite} />
  </main>
</Layout>

<style>
  .invite-page {
    max-width: 32rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    color: var(--theme-text, inherit);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
    color: var(--theme-accent-text, hsl(5, 53%, 32%));
    font-weight: 600;
    text-decoration: none;
    font-size: 0.875rem;
  }
  .back-link:hover,
  .back-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  h1 {
    font-size: 1.5rem;
    margin: 0 0 1.25rem;
  }
</style>
