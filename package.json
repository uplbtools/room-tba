{
	"name": "astro-room",
	"type": "module",
	"version": "2.21.6",
	"packageManager": "bun@1.3.14",
	"license": "MIT",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:debug": "astro dev --verbose",
		"build": "bash scripts/vercel-build-guard.sh && bun run generate:release-timestamps && bun run scripts/copy-maplibre-worker.ts && astro build",
		"generate:release-timestamps": "bun run scripts/generate-release-timestamps.ts",
		"check:vercel-env": "bash scripts/check-vercel-env.sh",
		"check:prod-branch": "bash scripts/check-production-branch.sh",
		"preview": "astro preview",
		"build:e2e": "ASTRO_E2E_NODE=1 bun run build",
		"preview:e2e": "bash scripts/preview-e2e.sh",
		"serve:e2e": "bash scripts/serve-e2e.sh",
		"astro": "astro",
		"lint": "biome check .",
		"check:undefined-names": "bun run scripts/check-undefined-names.ts",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"test": "bun test src/lib src/constants scripts/lib --path-ignore-patterns='**/*.store.test.ts' --path-ignore-patterns='**/*.component.test.ts'",
		"test:components": "vitest run",
		"test:integration": "bun test ./integration --preload ./integration/preload.ts --concurrency 1 --timeout 20000",
		"test:integration:live": "bash scripts/run-integration-preview.sh",
		"test:all": "bun test src/lib src/constants scripts/lib --path-ignore-patterns='**/*.store.test.ts' && bun run test:components && bun run test:integration",
		"e2e": "playwright test",
		"e2e:advisory": "playwright test -c playwright.advisory.config.ts",
		"e2e:staging": "playwright test -c playwright.staging.config.ts",
		"e2e:reset-db": "bun run scripts/e2e-reset-db.ts",
		"check:migrations": "bun run scripts/check-migrations.ts",
		"apply:migrations:prod": "bun run scripts/apply-migrations.ts --prod",
		"check:bundle": "bun run scripts/check-bundle-budget.ts",
		"generate:issue-test-matrix": "bun run scripts/generate-issue-test-matrix.ts /tmp/all-issues.json",
		"generate:test-inventory": "bun run scripts/generate-test-inventory.ts",
		"post:test-inventory-discord": "bun run scripts/post-test-inventory-discord.ts",
		"check:readme": "bun run scripts/check-readme-drift.ts",
		"fork:check": "bun run scripts/fork-check.ts",
		"fork:init": "bun run scripts/fork-init.ts",
		"install:agent-tooling": "bash scripts/install-agent-tooling.sh",
		"install:agent-plugins": "bash scripts/install-agent-plugins.sh",
		"install:shopped-skills": "bash scripts/install-shopped-skills.sh",
		"check:pwa-legal": "bun run scripts/check-pwa-legal-routes.ts",
		"check:feature-test-retirement": "bun run scripts/check-feature-test-retirement.ts",
		"seed:events": "bun src/seed-events.ts",
		"seed:aliases": "bun run scripts/seed-aliases.ts",
		"seed:sample": "bun run scripts/seed-sample-campus.ts",
		"seed:deep-research": "bun run scripts/seed-deep-research.ts",
		"seed:government-places": "bun run scripts/seed-government-places.ts",
		"generate:pglite-schema": "bun run scripts/generate-pglite-schema.ts",
		"import:osa-orgs": "bun run scripts/import-osa-organizations.ts",
		"import:trail-org-about": "bun run scripts/import-trail-org-about.ts",
		"audit:campus-data": "bun run scripts/audit-campus-data.ts",
		"apply:campus-audit-links": "bun run scripts/apply-campus-audit-links.ts",
		"audit:places-coordinates": "bun run scripts/places-coordinate-audit.ts",
		"import:campus-offices": "bun run scripts/import-campus-office-directory.ts",
		"import:amis-classes": "bun run scripts/import-amis-classes.ts",
		"import:classes-generic": "bun run scripts/import-classes-generic.ts",
		"backfill:room-full-names": "bun run scripts/backfill-room-full-names.ts",
		"consolidate:approved-rooms": "bun run scripts/consolidate-approved-rooms.ts",
		"backfill:acad-orgs": "for t in 1231 1232 1241 1242 1243 1251 1252 1253 1261; do bun run scripts/import-amis-classes.ts --term-id $t || exit 1; done",
		"import:final-exams": "bun run scripts/import-final-exams.ts",
		"record:bulk-history": "bun run scripts/record-bulk-history.ts",
		"backfill:bulk-history": "bun run scripts/backfill-bulk-history.ts",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/node": "^11.1.4",
		"@astrojs/svelte": "^9.0.1",
		"@astrojs/vercel": "^11.0.7",
		"@aws-sdk/client-s3": "^3.1115.0",
		"@datadog/browser-rum": "^7.8.0",
		"@electric-sql/pglite": "^0.5.4",
		"@esri/wayback-core": "^1.1.0",
		"@lucide/svelte": "^1.33.0",
		"@maplibre/maplibre-gl-directions": "^0.9.1",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.112.3",
		"@tailwindcss/vite": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/og": "^1.0.1",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"astro": "^7.2.4",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"es-toolkit": "^1.49.0",
		"maplibre-gl": "^6.4.1",
		"pdf-lib": "^1.17.1",
		"pg": "^8.23.0",
		"svelte": "^5.56.10",
		"svelte-maplibre": "^2.0.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.185.1",
		"typescript": "^7.0.2",
		"which-pm-runs": "^2.0.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.9",
		"@datadog/datadog-ci": "^5.23.0",
		"@playwright/test": "^1.62.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "^1.4.0",
		"@types/maplibre-gl": "^1.14.0",
		"@types/node": "^26.2.0",
		"@types/three": "^0.185.4",
		"@vercel/otel": "^2.1.3",
		"@vite-pwa/astro": "^1.2.0",
		"@vitest/browser": "^4.1.11",
		"bun": "^1.4.0",
		"dd-trace": "^6.11.0",
		"drizzle-kit": "^0.31.10",
		"globals": "^17.11.0",
		"happy-dom": "^20.11.6",
		"semantic-release": "^25.0.9",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"maplibre-gl": "^6.4.1"
	}
}
