{
	"name": "room-tba",
	"private": true,
	"version": "2.13.4",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check . && prettier --check \"src/**/*.svelte\"",
		"lint:fix": "biome check --write . && prettier --write \"src/**/*.svelte\"",
		"format": "biome format --write . && prettier --write \"src/**/*.svelte\"",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:components": "vitest run --project component",
		"apply:migrations": "bun run scripts/apply-migrations.ts",
		"apply:migrations:prod": "bun run scripts/apply-migrations.ts --prod",
		"e2e:reset-db": "bun run scripts/e2e-reset-db.ts",
		"check:migrations": "bun run scripts/check-migrations.ts",
		"check:feature-test-retirement": "bun run scripts/check-feature-test-retirement.ts",
		"generate:pglite-schema": "bun scripts/generate-pglite-schema.ts",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1090.0",
		"@datadog/browser-rum": "^7.5.0",
		"@electric-sql/pglite": "^0.5.4",
		"@lucide/svelte": "^1.25.0",
		"@maplibre/maplibre-gl-directions": "^0.9.1",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.7",
		"@vercel/og": "^1.0.1",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"es-toolkit": "^1.49.0",
		"maplibre-gl": "^5.24.0",
		"pg": "^8.22.0",
		"svelte-maplibre": "^1.3.0",
		"three": "^0.185.1",
		"wretch": "^3.0.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/bcrypt": "^6.0.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"@types/pg": "^8.15.6",
		"@types/three": "^0.185.3",
		"@vercel/otel": "^2.1.3",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.11.1",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
