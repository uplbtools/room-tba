{
	"name": "room-tba",
	"private": true,
	"version": "2.13.4",
	"type": "module",
	"scripts": {
		"dev": "vite -v dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check . && prettier --check \"src/**/*.svelte\"",
		"lint:fix": "biome check --write . && prettier --write \"src/**/*.svelte\"",
		"format": "biome format --write . && prettier --write \"src/**/*.svelte\"",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"apply:migrations": "bun run scripts/apply-migrations.ts",
		"apply:migrations:prod": "bun run scripts/apply-migrations.ts --prod",
		"check:migrations": "bun run scripts/check-migrations.ts",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1133.0",
		"@datadog/browser-rum": "^7.13.0",
		"@electric-sql/pglite": "^0.5.8",
		"@lucide/svelte": "^1.46.0",
		"@maplibre/maplibre-gl-directions": "^0.9.1",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"@vercel/og": "^1.0.2",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"es-toolkit": "^1.52.0",
		"maplibre-gl": "^6.10.0",
		"pg": "^8.23.0",
		"svelte-maplibre": "^2.0.0",
		"three": "^0.186.0",
		"valibot": "^1.5.0",
		"wretch": "^3.0.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/bcrypt": "^6.0.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"@types/three": "^0.186.0",
		"@vercel/otel": "^2.1.3",
		"@vitest/browser-playwright": "^5.0.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.5",
		"playwright": "^1.63.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	}
}
